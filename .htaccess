# Finance Dashboard — Apache rules for cPanel
# Keep rules simple and portable.

# --- Directory listing off ------------------------------------------------
Options -Indexes

# --- Default document ----------------------------------------------------
DirectoryIndex index.php index.html

# --- Deny access to sensitive files --------------------------------------
# Include-only PHP helpers (audit, csrf, database, auth, mailer, login-throttle,
# push-webpush) are require_once'd from entry pages — they must never be
# fetched directly. db-diag.php was a one-off diagnostic and is denied here
# in case any stale copy lingers on the server after the file was removed.
<FilesMatch "^(config\.php|config\.example\.php|database\.php|auth\.php|csrf\.php|functions\.php|mailer\.php|login-throttle\.php|audit\.php|push-webpush\.php|db-diag\.php|\.env.*|.*\.sql|.*\.md|composer\.(json|lock)|package(-lock)?\.json|.*\.(bak|backup|log|ini|conf|pem|key))$">
    Require all denied
</FilesMatch>

# --- Deny access to include-only libraries -------------------------------
# csv-lib.php and production-guard.php are pure library files required by
# their callers (export-csv.php, functions.php). Never fetched directly.
<FilesMatch "^(csv-lib\.php|production-guard\.php)$">
    Require all denied
</FilesMatch>

# --- Deny access to dotfiles ---------------------------------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# --- Deny access to private folders --------------------------------------
RedirectMatch 403 ^.*/database/.*$
RedirectMatch 403 ^.*/includes/.*$
RedirectMatch 403 ^.*/scripts/.*$
RedirectMatch 403 ^.*/tests/.*$

# --- HTTPS redirect ------------------------------------------------------
# TLS is confirmed on the production domain (finance.kktechsolutions.in),
# so upgrade all http requests to https at the edge.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Some hosts (Cloudflare, cPanel behind a proxy) pass X-Forwarded-Proto.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Basic security headers ----------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # HSTS — the production domain has been on HTTPS with a valid cert
    # since Phase 6. One-year max-age, subdomains included. Do NOT add
    # `preload` unless the domain is submitted to hstspreload.org.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
